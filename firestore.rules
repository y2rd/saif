rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. المنتجات والأقسام والكوبونات والطلبات العامة (store/*)
    // =========================================================================
    // - القراءة: متاحة للجميع لعرض محتويات المتجر
    // - الكتابة: متاحة لحفظ وتعديل المنتجات والأقسام، وتمنع حذف الكولكشنات
    match /store/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // منع الحذف العشوائي لكامل أقسام المتجر
    }

    // =========================================================================
    // 2. إعدادات المتجر العامة والهوية (settings/*)
    // =========================================================================
    match /settings/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // منع حذف الإعدادات
    }

    // =========================================================================
    // 3. قاعدة بيانات العملاء (Customers)
    // =========================================================================
    // - القراءة: متاحة للتطبيق لمزامنة قائمة العملاء وتسجيل الدخول
    // - الإنشاء: مسموح لتسجيل العملاء الجدد، برصيد يبدأ بـ 0 دائماً
    // - التحديث:
    //   * مسموح إذا لم يتغير الرصيد (تحديث ملف شخصي، نقاط، آخر دخول)
    //   * أو إذا نقص الرصيد (عملية شراء شرعية)
    //   * أو إذا كان التحديث يوثّق معاملة شحن في walletTransactions
    //   * منع الزيادة العشوائية بدون تسجيل معاملة
    // - الحذف: ممنوع حمايةً لبيانات العملاء وأرصدتهم
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.balance == null || 
                       request.resource.data.balance == 0 || 
                       request.resource.data.balance == 0.0;
      allow update: if 
        // 1. الرصيد لم يتغير إطلاقاً (تحديث الاسم، كلمة المرور، النقاط، آخر دخول)
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance']))
        // 2. أو نقص الرصيد (دفع قيمة طلب)
        || (request.resource.data.balance <= resource.data.balance)
        // 3. أو زيادة مشروطة بوجود سجل عملية مرفق
        || (request.resource.data.walletTransactions != null);
      allow delete: if false; // حماية حسابات العملاء من الحذف عبر الـ API
    }

    // =========================================================================
    // 4. الطلبات والمدفوعات (Orders)
    // =========================================================================
    // - القراءة: متاحة للمتجر
    // - الإنشاء والتحديث: متاحان لتسجيل الطلبات وتغيير حالتها
    // - الحذف: مسموح فقط بوجود معرف الطلب
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // منع مسح الطلبات عشوائياً
    }

    // =========================================================================
    // 5. طلبات شحن المحفظة (topups/*)
    // =========================================================================
    match /topups/{topupId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
