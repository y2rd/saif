rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. المنتجات والأقسام (Products & Categories)
    // =========================================================================
    // - القراءة (read): مسموحة للجميع (true) حتى يراها زوار المتجر والعملاء
    // - الكتابة (write): مسموحة للمتجر لحفظ وتعديل المنتجات والأقسام
    match /store/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 2. إعدادات المتجر العامة والهوية (Store Settings & Config)
    // =========================================================================
    // - القراءة: مسموحة للجميع لعرض اسم المتجر، الشعار، والبانرات
    // - الكتابة: مسموحة لحفظ التعديلات من لوحة التحكم
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 3. قاعدة بيانات العملاء (Customers)
    // =========================================================================
    // - تسجيل الدخول وحفظ حسابات العملاء الجدد
    match /customers/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 4. الطلبات والمدفوعات (Orders)
    // =========================================================================
    // - استقبال طلبات الشراء وتحديث حالاتها
    match /orders/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
